# Copy this file to .env, or run: neon env pull --file .env
# Never commit real values. .env is listed in .gitignore.

# Neon connection string (required)
DATABASE_URL=

# Direct, unpooled connection string (written by neon env pull; not used by the app)
DATABASE_URL_UNPOOLED=

# Free CoinGecko demo key (optional). Makes the daily ingest about three times faster.
COINGECKO_API_KEY=

# Only for scripts/refresh_coinswitch_pairs.py
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=
